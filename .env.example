# Supabase project credentials (required to persist enquiries)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: sales inbox notifications (wire into your preferred email provider)
SALES_EMAIL=hello@yourdomain.in

# Optional: set the live WhatsApp number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.in
